# --- Site password gate (HTTP Basic Auth, enforced in proxy.ts) ---
# Username for the Basic Auth prompt. Optional, defaults to "admin".
HUB_USER=admin
# Password for the Basic Auth prompt. If left unset, the site is OPEN (no auth)
# so local dev works without config. Set this in production.
HUB_PASSWORD=

# --- Write API (bearer auth for POST /api/add) ---
# Shared secret required as "Authorization: Bearer <token>" on /api/add.
# If unset, the write API rejects all requests with 401.
HUB_WRITE_TOKEN=

# --- GitHub (content writes commit JSON files back to the repo) ---
# Fine-grained Personal Access Token scoped to the hub repo with
# "Contents: Read and write" permission. No other scopes needed.
GITHUB_TOKEN=
# Target repository in "owner/repo" format.
GITHUB_REPO=owner/repo
# Branch to read/commit against. Optional, defaults to "main".
GITHUB_BRANCH=main
