# raw uploaded medical documents (PDFs / photos) - preserved locally + in the
# private repo, but NEVER served. Only extracted JSON is committed for the app.
# Keep .gitkeep so the folder exists; ignore the source files themselves.
/data/documents/*
!/data/documents/.gitkeep
!/data/documents/demo-lab.extracted.json
!/data/documents/README.md

# Garmin OAuth token (minted once via garth; never commit)
.garminconnect/
garmin-token*.json
